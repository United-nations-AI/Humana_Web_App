# Humana AI — Environment Variables
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is gitignored.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Anon/Public key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Service Role key (server-side only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Supabase Publishable / Secret keys (SDK v2 client auth)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>
SUPABASE_SECRET_KEY=<your-supabase-secret-key>

# ── OpenAI ────────────────────────────────────────────────────────────────────
# The OpenAI key is stored as a Supabase Edge Function secret, NOT here.
# Set it via CLI:
#   supabase secrets set OPENAI_API_KEY=sk-... --project-ref <your-project-ref>
# Or via: Supabase Dashboard → Project Settings → Edge Functions → Secrets

# ── Learning platform ─────────────────────────────────────────────────────────
# Secret used to sign course-completion certificates (server-side only).
# Any random string of 16+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LEARN_CERT_SECRET=<random-string>
